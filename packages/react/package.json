{
  "name": "@form-engine/react",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "files": [
    "dist",
    "src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react/jsx-runtime --external @form-engine/core",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run --globals",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@form-engine/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  }
}
