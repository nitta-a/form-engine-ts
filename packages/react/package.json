{
  "name": "@form-engine-ts/react",
  "version": "8.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./attempt": {
      "types": "./dist/attempt.d.ts",
      "import": "./dist/attempt.js",
      "require": "./dist/attempt.cjs"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./content-renderer": {
      "types": "./dist/contentRenderer.d.ts",
      "import": "./dist/contentRenderer.js",
      "require": "./dist/contentRenderer.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js",
      "require": "./dist/receipt.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js",
      "require": "./dist/renderer.cjs"
    },
    "./submission": {
      "types": "./dist/submission.d.ts",
      "import": "./dist/submission.js",
      "require": "./dist/submission.cjs"
    },
    "./submission-identity": {
      "types": "./dist/submissionIdentity.d.ts",
      "import": "./dist/submissionIdentity.js",
      "require": "./dist/submissionIdentity.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitta-a/form-engine-ts.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/form-engine-ts/issues"
  },
  "homepage": "https://github.com/nitta-a/form-engine-ts#readme",
  "keywords": [
    "form",
    "survey",
    "react",
    "form-builder",
    "typescript"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external react/jsx-runtime --external @form-engine-ts/core --external @form-engine-ts/privacy && tsup src/attempt.ts src/builder.tsx src/contentRenderer.tsx src/context.tsx src/hooks.ts src/i18n.ts src/receipt.ts src/renderer.tsx src/submission.ts src/submissionIdentity.ts src/types.ts --format esm,cjs --dts --external react --external react/jsx-runtime --external @form-engine-ts/core --external @form-engine-ts/privacy && tsup src/styles.css --format esm,cjs --external react --external react/jsx-runtime --external @form-engine-ts/core --external @form-engine-ts/privacy",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run --globals",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@form-engine-ts/core": "workspace:*",
    "@form-engine-ts/privacy": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "axe-core": "^4.11.0"
  }
}
