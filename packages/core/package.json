{
  "name": "@form-engine-ts/core",
  "version": "7.15.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./aggregation": {
      "types": "./dist/aggregation.d.ts",
      "import": "./dist/aggregation.js",
      "require": "./dist/aggregation.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "require": "./dist/analytics.cjs"
    },
    "./content-mode": {
      "types": "./dist/contentMode.d.ts",
      "import": "./dist/contentMode.js",
      "require": "./dist/contentMode.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js",
      "require": "./dist/field.cjs"
    },
    "./field-types": {
      "types": "./dist/fieldTypes.d.ts",
      "import": "./dist/fieldTypes.js",
      "require": "./dist/fieldTypes.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "require": "./dist/i18n/index.cjs"
    },
    "./i18n/en": {
      "types": "./dist/i18n/catalogs/en.d.ts",
      "import": "./dist/i18n/catalogs/en.js",
      "require": "./dist/i18n/catalogs/en.cjs"
    },
    "./i18n/ja": {
      "types": "./dist/i18n/catalogs/ja.d.ts",
      "import": "./dist/i18n/catalogs/ja.js",
      "require": "./dist/i18n/catalogs/ja.cjs"
    },
    "./i18n/keys": {
      "types": "./dist/i18n/keys.d.ts",
      "import": "./dist/i18n/keys.js",
      "require": "./dist/i18n/keys.cjs"
    },
    "./i18n/translator": {
      "types": "./dist/i18n/translator.d.ts",
      "import": "./dist/i18n/translator.js",
      "require": "./dist/i18n/translator.cjs"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js",
      "require": "./dist/locale.cjs"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js",
      "require": "./dist/pagination.cjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js",
      "require": "./dist/pipeline.cjs"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "require": "./dist/policy.cjs"
    },
    "./response-summary": {
      "types": "./dist/responseSummary.d.ts",
      "import": "./dist/responseSummary.js",
      "require": "./dist/responseSummary.cjs"
    },
    "./sanitization": {
      "types": "./dist/sanitization.d.ts",
      "import": "./dist/sanitization.js",
      "require": "./dist/sanitization.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./submission": {
      "types": "./dist/submission.d.ts",
      "import": "./dist/submission.js",
      "require": "./dist/submission.cjs"
    },
    "./translation": {
      "types": "./dist/translation.d.ts",
      "import": "./dist/translation.js",
      "require": "./dist/translation.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "require": "./dist/validation.cjs"
    },
    "./versioning": {
      "types": "./dist/versioning.d.ts",
      "import": "./dist/versioning.js",
      "require": "./dist/versioning.cjs"
    },
    "./visibility": {
      "types": "./dist/visibility.d.ts",
      "import": "./dist/visibility.js",
      "require": "./dist/visibility.cjs"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitta-a/form-engine-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/form-engine-ts/issues"
  },
  "homepage": "https://github.com/nitta-a/form-engine-ts#readme",
  "keywords": [
    "form",
    "survey",
    "schema",
    "validation",
    "typescript"
  ],
  "dependencies": {
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/aggregation.ts src/analytics.ts src/contentMode.ts src/errors.ts src/events.ts src/field.ts src/fieldTypes.ts src/i18n/index.ts src/i18n/catalogs/en.ts src/i18n/catalogs/ja.ts src/i18n/keys.ts src/i18n/translator.ts src/locale.ts src/pagination.ts src/pipeline.ts src/policy.ts src/responseSummary.ts src/sanitization.ts src/schema.ts src/submission.ts src/translation.ts src/types.ts src/validation.ts src/versioning.ts src/visibility.ts --format esm,cjs --dts",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run --globals",
    "typecheck": "tsc --noEmit"
  }
}
