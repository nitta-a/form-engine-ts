{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@form-engine/core": ["./packages/core/src/index.ts"],
      "@form-engine/react": ["./packages/react/src/index.ts"],
      "@form-engine/storage-localstorage": ["./packages/storage-localstorage/src/index.ts"],
      "@form-engine/storage-memory": ["./packages/storage-memory/src/index.ts"],
      "@form-engine/storage-mongodb": ["./packages/storage-mongodb/src/index.ts"],
      "@form-engine/translator-azure": ["./packages/translator-azure/src/index.ts"],
      "@form-engine/translator-deepl": ["./packages/translator-deepl/src/index.ts"],
      "@form-engine/translator-google": ["./packages/translator-google/src/index.ts"],
      "@form-engine/translator-mock": ["./packages/translator-mock/src/index.ts"],
      "@form-engine/zod": ["./packages/zod/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": true
  }
}
