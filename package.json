{
  "name": "form-engine-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "api:check": "pnpm build && node scripts/check-public-api.mjs check",
    "api:update": "pnpm build && node scripts/check-public-api.mjs update",
    "package:check": "node scripts/check-package-exports.mjs",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --filter=@form-engine-ts/preview",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "turbo run test",
    "test:release": "node --test scripts/check-public-api.test.mjs scripts/release-packages.test.mjs",
    "turbo": "turbo",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
